# Gemini (required only for live discovery runs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local demo bank proxy origin (allowlist default later)
DEMO_CORE_ORIGIN=http://127.0.0.1:4173
DEMO_CORE_PORT=4173
DEMO_CORE_PASSWORD=demo-pass

# Logging
LOG_LEVEL=info

# Never put real bank credentials or real PII here.
